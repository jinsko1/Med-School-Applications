  "medSchoolStudLife": {
    "medicalSchoolId": 27132,
    "diversity": "For over 45 years, CDU has produced the most minority health professionals in California. ",
    "leaveOfAbsence": null,
    "organizationActivities": "Student organizations are plentiful at CDU. Students can choose from more than 40 approved student organizations. There are also many professional groups such as the Student National Medical Association, the American Muslim Student Association, and the Latino Medical Student Association West. ",
    "setting": "Located in Los Angeles, CDU offers numerous theaters, dining, recreation, athletics, and cultural event opportunities. This and the location of the campus on the south side of Los Angeles make CDU an ideal place to study, learn and explore. ",
    "housing": "Most students reside in communities surrounding the campus including Lynwood, Willowbrook, Compton, Downey, and Gardena. ",
    "supportSystems": "CDU is committed to supporting students who identify as LGBTQIA+ through student services, student organizations, as well as educational and community support.  CDU College of Medicine is committed to creating and maintaining a learning environment that supports and encourages a culture of respect between teacher and learner. The MD Program ensures that the learning environment is conducive to the ongoing development of explicit and appropriate professional behaviors in its medical students, faculty, and staff at all locations and is one in which all individuals are treated with respect.   ",
    "supportSystemsForDisabilities": null,
    "wellnessPrograms": "We have a licensed clinical psychologist who provides mental health services and workshops throughout the year tailored to student needs. https://www.cdrewu.edu/students-campus-life/student-services/health-and-wellness/\n",
    "campusCulture": "Charles R. Drew University of Medicine and Science (CDU) is a small but vibrant historically Black college and university (HBCU) and Hispanic-serving institution (HSI) located in the Watts-Willowbrook area of South Los Angeles. The campus culture at CDU is deeply rooted in a legacy of social justice, health equity, and community empowerment. Here are some key aspects of CDU\u2019s unique campus culture: , mission driven environment, commitment to social justice and health equity, and close knit community",
    "transportationDriverLicense": "Recommended",
    "transportationVehicle": "Required",
    "transportationAdditionalInfo": "Students will have to drive to preceptorship and clerkships",
    "additionalSupportProgrameName": "Learning Skills"
  },
  "medSchoolCurriculum": {
    "medicalSchoolId": 27132,
    "dressCode": "For the basic science years: casual attire except for days attending clinical preceptorships. Clinical years: professional attire is required with white coat.",
    "tutoringPrograms": "Yes. We have learning skills specialists, supplemental instructors, and tutors",
    "globalExperience": null,
    "patientInteraction": "MS1 Students observe patient care during clinical preceptorships as part of Clinical Skills 1. Exposure to patient care continues in year 2 with Clinical Skills 2. MS3 and MS4 are the clinical years.",
    "instructionStyle": "Varied including case-based, problem-based, team-based, simulation and self-directed learning.",
    "clinicalRotations": "Clinical rotations begin in February of the 2nd year. ",
    "prematriculationProgram": "Gateway is composed of didactics, small group discussions, & interactive learning skill sessions to assess students\u2019 study and enhance test-taking skills.",
    "rankStudents": "",
    "lectureAttendance": "mandatory, all classes are in person",
    "curricularHighlights": "The MD Program curriculum is based on the CDU Advantage, which has five areas of focused content across the undergraduate and graduate training. These five domains include: excellence in specialized knowledge and research, social justice, global-international experience, community and experiential education, and health policy. The MD Program curriculum is designed to integrate the institutional learning objectives (ILOs) of the CDU Advantage into the medical education curriculum and ensure graduates meet the MD Program\u2019s required competencies and educational program objectives. Additionally, Entrustable Professional Activities (EPAs) for entering residency have been added to the medical education program objectives and linked to the relevant competencies. ",
    "primaryCarePrograms": "Yes. We have residency programs in Family medicine, and Internal medicine at CDU",
    "researchPrograms": "Summer between first and second year",
    "videoOnlineLectures": "C",
    "academicSystem": "O",
